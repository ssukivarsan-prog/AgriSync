# ============================================================
# AgriVyn / AgriSync — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file itself — it is in .gitignore.
# ============================================================

# ── Twilio Voice & SMS API ───────────────────────────────────
# Sign up free at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Public Webhook URL (for Twilio to call back) ─────────────
# Use ngrok to expose localhost: `ngrok http 8000`
# Then paste the https ngrok URL here:
PUBLIC_SERVER_URL=https://your-tunnel.ngrok-free.app

# ── Voice Call Defaults ──────────────────────────────────────
# Language for outbound AI voice calls: 'ta' (Tamil) or 'en' (English)
DEFAULT_CALL_LANGUAGE=ta

# ── Optional: Custom TwiML Bin (Twilio-hosted fallback voice) ─
# Create at: https://console.twilio.com/us1/develop/twiml-bins
TWILIO_VOICE_URL=

# ── Backend Settings (usually no need to change) ─────────────
# BACKEND_PORT=8000
# DEBUG=false
